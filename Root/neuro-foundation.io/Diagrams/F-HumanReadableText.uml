@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 24
skinparam ranksep 30
skinparam rectangle {
  BackgroundColor white
  BorderColor #B7C2CE
  RoundCorner 12
}

rectangle Group1 [
<b>Block Elements</b>
{{
left to right direction

skinparam classAttributeIconSize 0
hide circle
hide empty members

object paragraph
object section
object header
object body
object bulletItems
object item
object numberedItems
object imageStandalone
object separator
object table
object row
object cell
abstract class InlineElement #EAF2FA
abstract class BlockElement #EAF2FA
abstract class ImageType #EAF2FA

paragraph --|> BlockElement
paragraph "1" *-- "*" InlineElement

section --|> BlockElement
section *-- header
section *-- body
header "1" *-- InlineElement
body "1" *-- BlockElement

bulletItems --|> BlockElement
bulletItems "1" *-- "*" item
item "0/1" *-- InlineElement
item "1/0" *-- BlockElement

numberedItems --|> BlockElement
numberedItems "1" *-- "*" item

imageStandalone --|> ImageType

separator --|> BlockElement

table --|> BlockElement
table "1" *-- "*" row
row "1" *-- "*" cell
cell : alignment
cell : colSpan
cell : header
cell "0/1" *-- InlineElement
cell "0/1" *-- BlockElement
}}
]

rectangle Group2 [
<b>Inline Elements</b>
{{
left to right direction

skinparam classAttributeIconSize 0
hide circle
hide empty members

object text
object parameter
object bold
object italic
object underline
object strikeThrough
object super
object sub
object lineBreak
object imageInline
abstract class InlineElement #EAF2FA
abstract class ImageType #EAF2FA

text --|> InlineElement

parameter --|> InlineElement
parameter : name

bold --|> InlineElement
bold "1" *-- "*" InlineElement

italic --|> InlineElement
italic "1" *-- "*" InlineElement

underline --|> InlineElement
underline "1" *-- "*" InlineElement

strikeThrough --|> InlineElement
strikeThrough "1" *-- "*" InlineElement

super --|> InlineElement
super "1" *-- "*" InlineElement

sub --|> InlineElement
sub "1" *-- "*" InlineElement

lineBreak --|> InlineElement

imageInline --|> ImageType
}}
]

rectangle Group3 [
<b>Images</b>
{{
left to right direction

skinparam classAttributeIconSize 0
hide circle
hide empty members

object caption
abstract class InlineElement #EAF2FA
abstract class ImageType #EAF2FA

ImageType *-- caption
ImageType : binary
ImageType : contentType
ImageType : width
ImageType : height
caption "1" *-- "*" InlineElement

}}
]

rectangle Group4 [
<b>Contract Elements with human-readable content</b>
{{
left to right direction

skinparam classAttributeIconSize 0
hide circle
hide empty members

object humanReadableText
object description
object label
abstract class HumanReadableText #EAF2FA
abstract class BlockElement #EAF2FA
abstract class InlineElement #EAF2FA

humanReadableText : xml:lang

description : xml:lang

label : xml:lang

humanReadableText --|> HumanReadableText
description --|> HumanReadableText

HumanReadableText "1" *-- "*" BlockElement

label "1" *-- "*" InlineElement
}}
]

@enduml
